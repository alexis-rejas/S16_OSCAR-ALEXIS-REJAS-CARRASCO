<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox spacing="12" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.vallegrande.app.controller.ProductoController">
<padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
<Label text="SISTEMA DE GESTION DE FERRETERIA" style="-fx-font-size:18px;-fx-font-weight:bold;"/>
<GridPane hgap="10" vgap="8">
<Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/><TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
<Label text="Categoria:" GridPane.columnIndex="2" GridPane.rowIndex="0"/><TextField fx:id="txtCategoria" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
<Label text="Marca:" GridPane.columnIndex="0" GridPane.rowIndex="1"/><TextField fx:id="txtMarca" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
<Label text="Proveedor:" GridPane.columnIndex="2" GridPane.rowIndex="1"/><TextField fx:id="txtProveedor" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
<Label text="P. Compra:" GridPane.columnIndex="0" GridPane.rowIndex="2"/><TextField fx:id="txtPrecioCompra" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
<Label text="P. Venta:" GridPane.columnIndex="2" GridPane.rowIndex="2"/><TextField fx:id="txtPrecioVenta" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
<Label text="Stock:" GridPane.columnIndex="0" GridPane.rowIndex="3"/><TextField fx:id="txtStock" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
</GridPane>
<HBox spacing="10">
<Button text="Registrar" onAction="#onRegistrar" style="-fx-background-color:#28a745;-fx-text-fill:white;"/>
<Button text="Actualizar" onAction="#onActualizar" style="-fx-background-color:#007bff;-fx-text-fill:white;"/>
<Button text="Eliminar" onAction="#onEliminar" style="-fx-background-color:#dc3545;-fx-text-fill:white;"/>
<Button text="Limpiar" onAction="#onLimpiar"/>
</HBox>
<TableView fx:id="tblProductos" VBox.vgrow="ALWAYS"><columns>
<TableColumn fx:id="colId" text="ID" prefWidth="45"/><TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
<TableColumn fx:id="colCategoria" text="Categoria" prefWidth="120"/><TableColumn fx:id="colMarca" text="Marca" prefWidth="100"/>
<TableColumn fx:id="colPrecioCompra" text="P. Compra" prefWidth="80"/><TableColumn fx:id="colPrecioVenta" text="P. Venta" prefWidth="80"/>
<TableColumn fx:id="colStock" text="Stock" prefWidth="60"/><TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="150"/>
</columns></TableView></VBox>